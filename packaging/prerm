#!/bin/sh
set -eu
case "$1" in
  remove|deconfigure|upgrade)
    if [ -d /run/systemd/system ]; then
      # An upgrade keeps the timer in the state the operator left it (enabled and active stays so, disabled stays so);
      # only a removal or a deconfigure disables and stops it.
      if [ "$1" != upgrade ]; then
        systemctl disable --now onedrive-backup.timer 2>/dev/null || true
      fi
      systemctl stop onedrive-backup-api.service 2>/dev/null || true
    fi
    ;;
esac
exit 0
