#!/bin/sh
set -eu
if [ "$1" = configure ]; then
  if ! id onedrive-backup >/dev/null 2>&1; then
    adduser --system --group --home /var/lib/onedrive-backup \
      --no-create-home --shell /usr/sbin/nologin onedrive-backup
  fi
  install -d -m 0700 -o onedrive-backup -g onedrive-backup \
    /var/lib/onedrive-backup /var/lib/onedrive-backup/secrets
  install -d -m 0700 -o root -g root /var/lib/onedrive-backup/credentials
  install -d -m 0750 -o root -g onedrive-backup \
    /etc/onedrive-backup /etc/onedrive-backup/certs
  for f in /etc/onedrive-backup/server.json /etc/onedrive-backup/backup.json; do
    if [ -f "$f" ]; then
      chown root:onedrive-backup "$f"
      chmod 0640 "$f"
    fi
  done
  # Upgrade pre-0.3.1 conffiles without clobbering operator settings.
  # CRL policy is now managed by MCP Proxy, never by this backend.
  if [ -f /etc/onedrive-backup/server.json ]; then
    python3 - <<'PY_MIGRATE_CRL'
import json
import os
from pathlib import Path
import tempfile

path = Path("/etc/onedrive-backup/server.json")
config = json.loads(path.read_text(encoding="utf-8"))
changed = False
for section in ("server", "registration"):
    tls = config.get(section, {}).get("ssl")
    if isinstance(tls, dict) and tls.get("crl") is not None:
        tls["crl"] = None
        changed = True
if changed:
    stat = path.stat()
    fd, name = tempfile.mkstemp(prefix=".onedrive-tls-", dir=path.parent)
    try:
        os.fchmod(fd, stat.st_mode & 0o777)
        os.fchown(fd, stat.st_uid, stat.st_gid)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(config, handle, indent=2, ensure_ascii=False)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(name, path)
    finally:
        if os.path.exists(name):
            os.unlink(name)
PY_MIGRATE_CRL
  fi
  # Keep configured paths; create defaults only when absent.
  template=/usr/share/onedrive-backup/defaults
  default=/etc/default/onedrive-backup
  if [ ! -e "$default" ]; then
    install -m 0644 -o root -g root "$template" "$default"
  else
    [ ! -L "$default" ] || { echo 'Unsafe /etc/default symlink' >&2; exit 2; }
    for k in ONEDRIVE_CERT_SOURCE ONEDRIVE_KEY_SOURCE ONEDRIVE_PROXY_CA_SOURCE ONEDRIVE_CLIENT_CA_SOURCE ONEDRIVE_CREDENTIALS_FILE ONEDRIVE_SCAFFOLD_DATA_DIR; do
      if ! grep -q "^$k=" "$default"; then
        grep "^$k=" "$template" >> "$default"
      fi
    done
    # Old autogenerated defaults pinned the image. Follow the package
    # image-spec automatically; never alter custom repository overrides.
    sed -i -E '/^ONEDRIVE_IMAGE=vasilyvz\/onedrive-backup:[0-9]+\.[0-9]+\.[0-9]+$/d' "$default"
    chmod 0644 "$default"
    chown root:root "$default"
  fi
  if /usr/lib/onedrive-backup/install-runtime.sh; then
    if [ -d /run/systemd/system ]; then
      systemctl daemon-reload
      systemctl enable onedrive-backup-api.service
      if systemctl is-active --quiet onedrive-backup-api.service; then
        systemctl restart onedrive-backup-api.service
      else
        systemctl start onedrive-backup-api.service
      fi
    fi
  else
    status=$?
    if [ "$status" -eq 10 ] || [ "$status" -eq 11 ] || [ "$status" -eq 12 ]; then
      echo 'onedrive-backup: prerequisites incomplete; API startup deferred'
    else
      exit "$status"
    fi
  fi
  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload || true
  fi
  # Restricted scaffold is permitted; the backup timer stays disabled.
fi
exit 0

