#!/bin/sh
set -eu
if [ "$1" = configure ]; then
  if ! id onedrive-backup >/dev/null 2>&1; then
    adduser --system --group --home /var/lib/onedrive-backup \
      --no-create-home --shell /usr/sbin/nologin onedrive-backup
  fi
  install -d -m 0700 -o onedrive-backup -g onedrive-backup \
    /var/lib/onedrive-backup /var/lib/onedrive-backup/secrets
  # Writable state of the service: rclone keeps its refreshed OAuth token in a copy of rclone.conf here (the original
  # under secrets stays read-only). docker-run.sh start seeds the copy.
  install -d -m 0700 -o onedrive-backup -g onedrive-backup /var/lib/onedrive-backup/rclone-state
  # docker/deploy.sh stores the restic password as root; the service user reads it through the read-only mount.
  restic_password=/var/lib/onedrive-backup/secrets/restic-password
  if [ -f "$restic_password" ] && [ ! -L "$restic_password" ]; then
    chown onedrive-backup:onedrive-backup "$restic_password"
    chmod 0600 "$restic_password"
  fi
  install -d -m 0700 -o root -g root /var/lib/onedrive-backup/credentials
  install -d -m 0750 -o root -g onedrive-backup \
    /etc/onedrive-backup /etc/onedrive-backup/certs
  for f in /etc/onedrive-backup/server.json /etc/onedrive-backup/backup.json; do
    if [ -f "$f" ]; then
      chown root:onedrive-backup "$f"
      chmod 0640 "$f"
    fi
  done
  # Upgrade pre-0.3.1 conffiles without clobbering operator settings.
  # CRL policy is now managed by MCP Proxy, never by this backend.
  if [ -f /etc/onedrive-backup/server.json ]; then
    python3 - <<'PY_MIGRATE_CRL'
import json
import os
from pathlib import Path
import tempfile

path = Path("/etc/onedrive-backup/server.json")
config = json.loads(path.read_text(encoding="utf-8"))
changed = False
for section in ("server", "registration"):
    tls = config.get(section, {}).get("ssl")
    if isinstance(tls, dict) and tls.get("crl") is not None:
        tls["crl"] = None
        changed = True
if changed:
    stat = path.stat()
    fd, name = tempfile.mkstemp(prefix=".onedrive-tls-", dir=path.parent)
    try:
        os.fchmod(fd, stat.st_mode & 0o777)
        os.fchown(fd, stat.st_uid, stat.st_gid)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(config, handle, indent=2, ensure_ascii=False)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(name, path)
    finally:
        if os.path.exists(name):
            os.unlink(name)
PY_MIGRATE_CRL
  fi
  # Keep configured paths; create defaults only when absent.
  template=/usr/share/onedrive-backup/defaults
  default=/etc/default/onedrive-backup
  if [ ! -e "$default" ]; then
    install -m 0644 -o root -g root "$template" "$default"
  else
    [ ! -L "$default" ] || { echo 'Unsafe /etc/default symlink' >&2; exit 2; }
    for k in ONEDRIVE_CERT_SOURCE ONEDRIVE_KEY_SOURCE ONEDRIVE_PROXY_CA_SOURCE ONEDRIVE_CLIENT_CA_SOURCE ONEDRIVE_CREDENTIALS_FILE ONEDRIVE_SCAFFOLD_DATA_DIR ONEDRIVE_RCLONE_STATE_DIR; do
      if ! grep -q "^$k=" "$default"; then
        grep "^$k=" "$template" >> "$default"
      fi
    done
    # Old autogenerated defaults pinned the image. Follow the package
    # image-spec automatically; never alter custom repository overrides.
    sed -i -E '/^ONEDRIVE_IMAGE=vasilyvz\/onedrive-backup:[0-9]+\.[0-9]+\.[0-9]+$/d' "$default"
    chmod 0644 "$default"
    chown root:root "$default"
  fi
  # The backup data directory is a plain host directory owned by the service user on the mounted /srv/archive
  # filesystem. postinst never creates, changes or hands over that directory: it refuses (exit 2) when the archive
  # filesystem is not mounted, when the directory is not on it, or when it does not exist.
  archive=/srv/archive
  data_dir=/srv/archive/onedrive-backup
  configured="$(sed -n 's/^ONEDRIVE_DATA_DIR=//p' "$default" | tail -n 1 | tr -d '"')"
  if [ -n "$configured" ]; then data_dir="$configured"; fi
  case "$data_dir" in
    /*) ;;
    *) echo 'onedrive-backup: ONEDRIVE_DATA_DIR must be absolute' >&2; exit 2 ;;
  esac
  fs_describe() {
    probe="$1"
    while [ ! -e "$probe" ] && [ "$probe" != / ]; do probe="$(dirname "$probe")"; done
    line="$(findmnt -n -o TARGET,SOURCE -T "$probe" 2>/dev/null | head -n 1 || true)"
    target="${line%% *}"
    source="${line#* }"
    if [ -z "$target" ]; then
      echo 'an unknown filesystem'
    elif [ "$target" = / ]; then
      echo "the root filesystem ($source)"
    else
      echo "the filesystem $source mounted at $target"
    fi
  }
  mreal="$(realpath -m "$archive")"
  real="$(realpath -m "$data_dir")"
  if ! findmnt -n -M "$archive" >/dev/null 2>&1; then
    echo "onedrive-backup: $archive is not mounted: the data directory $real is on $(fs_describe "$real"); it must be on the mounted $archive filesystem" >&2
    exit 2
  fi
  if [ -e "$data_dir" ]; then :; else
    echo "onedrive-backup: Host data directory does not exist: $data_dir; create it on the $archive filesystem (postinst never creates it)" >&2
    exit 2
  fi
  target="$(findmnt -n -o TARGET -T "$data_dir" 2>/dev/null | head -n 1 || true)"
  on_archive=0
  case "$target" in
    "$archive"|"$archive"/*|"$mreal"|"$mreal"/*) on_archive=1 ;;
  esac
  case "$real" in
    "$mreal"|"$mreal"/*) ;;
    *) on_archive=0 ;;
  esac
  if [ "$on_archive" != 1 ]; then
    echo "onedrive-backup: the data directory $real is not on the $archive filesystem: it is on $(fs_describe "$real")" >&2
    exit 2
  fi
  # Matrix 10.20.8 (rev 12): the host systemd timer is retired, the schedule is the file <data>/schedule/schedule.cron.
  # The state of the old timer comes from the preinst capture of this upgrade, else from systemctl; a fresh install has
  # no timer. The file is created only when absent; the retired timer's state decides ENABLED (never silently resumed).
  prev="${2:-}"
  timer=onedrive-backup.timer
  captured=/var/lib/onedrive-backup/timer-state.pre
  tenabled=no
  tactive=no
  show=""
  if [ -f "$captured" ]; then
    tenabled="$(sed -n 's/^enabled=//p' "$captured" | head -n 1)"
    tactive="$(sed -n 's/^active=//p' "$captured" | head -n 1)"
    show="$(grep -v '^enabled=\|^active=' "$captured" || true)"
    rm -f "$captured"
  elif [ -n "$prev" ] && [ -d /run/systemd/system ]; then
    if systemctl is-enabled "$timer" >/dev/null 2>&1; then tenabled=yes; fi
    if systemctl is-active "$timer" >/dev/null 2>&1; then tactive=yes; fi
    show="$(systemctl show "$timer" 2>/dev/null || true)"
  fi
  if [ -n "$prev" ] && [ -d /run/systemd/system ]; then
    systemctl disable --now "$timer" >/dev/null 2>&1 || true
  fi
  if [ "$tenabled" = yes ] || [ "$tactive" = yes ]; then schedule_enabled=yes; else schedule_enabled=no; fi
  if [ -n "$show" ] || [ "$schedule_enabled" = yes ]; then
    ( umask 077
      {
        echo '# previous systemd timer onedrive-backup.timer, retired by the schedule file'
        echo "enabled=$tenabled"
        echo "active=$tactive"
        printf '%s\n' "$show" | grep -E '^(OnCalendar|TimersCalendar|RandomizedDelay|Persistent|DropInPaths)' || true
      } > /var/lib/onedrive-backup/timer-migration.txt )
    chmod 0600 /var/lib/onedrive-backup/timer-migration.txt
    oncal="$(printf '%s\n' "$show" | sed -n -e 's/^OnCalendar=//p' -e 's/^TimersCalendar={ OnCalendar=\([^;]*[^ ;]\) *;.*/\1/p' | head -n 1)"
    dropin="$(printf '%s\n' "$show" | sed -n 's/^DropInPaths=//p' | head -n 1)"
    if [ "$oncal" != '*-*-* 02:30:00' ] || [ -n "$dropin" ]; then
      echo 'onedrive-backup: NOT MIGRATED: re-enter the schedule; the old timer settings are in /var/lib/onedrive-backup/timer-migration.txt'
    fi
  fi
  schedule_dir="$data_dir/schedule"
  if [ ! -e "$schedule_dir/schedule.cron" ]; then
    install -d -m 0700 -o onedrive-backup -g onedrive-backup "$schedule_dir"
    schedule_tmp="$(mktemp)"
    {
      printf '%s\n' '# OneDrive backup schedule (edit through the API, the client, odbcli or the UI).' \
        '# Fields: minute hour day-of-month month day-of-week. Lines starting with # are comments.' \
        'TZ=Europe/Kyiv' 'JITTER=15m' 'CATCHUP=24h'
      if [ "$schedule_enabled" != yes ]; then printf '%s\n' 'ENABLED=no'; fi
      printf '%s\n' '30 2 * * *'
    } > "$schedule_tmp"
    install -m 0600 -o onedrive-backup -g onedrive-backup "$schedule_tmp" "$schedule_dir/schedule.cron"
    rm -f "$schedule_tmp"
    if [ "$schedule_enabled" = yes ]; then
      echo 'onedrive-backup: the daily backup moved from the systemd timer to the schedule file schedule/schedule.cron (02:30 Europe/Kyiv)'
    else
      echo 'onedrive-backup: the backup schedule file was created with ENABLED=no; set ENABLED=yes (odbcli schedule-set) to start backups'
    fi
  fi
  if /usr/lib/onedrive-backup/install-runtime.sh; then
    if [ -d /run/systemd/system ]; then
      systemctl daemon-reload
      systemctl enable onedrive-backup-api.service
      if systemctl is-active --quiet onedrive-backup-api.service; then
        systemctl restart onedrive-backup-api.service
      else
        systemctl start onedrive-backup-api.service
      fi
    fi
  else
    status=$?
    if [ "$status" -eq 10 ] || [ "$status" -eq 11 ] || [ "$status" -eq 12 ]; then
      echo 'onedrive-backup: prerequisites incomplete; API startup deferred'
    else
      exit "$status"
    fi
  fi
  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload || true
  fi
  # Restricted scaffold is permitted; the schedule file decides when backups start (ENABLED, entries).
fi
exit 0
