#!/bin/sh
set -eu
[ "$(id -u)" -eq 0 ] || { echo 'Use sudo for admin password setup' >&2; exit 1; }
PYTHONPATH=/usr/lib/onedrive-backup python3 -m onedrive_api.admin_password --file /etc/onedrive-backup/admin-password.hash
chown onedrive-backup:onedrive-backup /etc/onedrive-backup/admin-password.hash
chmod 0600 /etc/onedrive-backup/admin-password.hash
