[Unit]
Description=OneDrive Backup API production Docker container (mTLS)
Wants=network-online.target docker.service
After=network-online.target docker.service
Requires=docker.service
ConditionPathExists=/etc/onedrive-backup/certs/server.crt

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/etc/default/onedrive-backup
ExecStart=/usr/lib/onedrive-backup/docker-run.sh start
ExecStop=/usr/lib/onedrive-backup/docker-run.sh stop
TimeoutStartSec=180
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
