# Committed pipeline endpoints. The file is never named .env and carries no secret: certificates,
# keys, tokens and passwords stay outside git. The same file is used on every branch.
# Selection: pipeline/environment.py derives PIPELINE_ENV from the git branch (main = prod, any
# other branch = dev) and reads <BASE>_DEV or <BASE>_PROD. No other pipeline module holds a URL.
# onedrive-backup is a production-only service (no DEV installation, no -dev client), so every
# DEV value equals its PROD value. The MCP Proxy is the one shared production proxy.
# ENDPOINTS_PENDING lists bases whose service is not deployed yet; their values stay empty (none since revision 8).
ENDPOINTS_PENDING=

# MCP Proxy (registration and heartbeat of the service, taken from config/server.json).
MCP_PROXY_URL_DEV=https://mcp-proxy:3004
MCP_PROXY_URL_PROD=https://mcp-proxy:3004
MCP_PROXY_REGISTER_URL_DEV=https://mcp-proxy:3004/register
MCP_PROXY_REGISTER_URL_PROD=https://mcp-proxy:3004/register
MCP_PROXY_HEARTBEAT_URL_DEV=https://mcp-proxy:3004/proxy/heartbeat
MCP_PROXY_HEARTBEAT_URL_PROD=https://mcp-proxy:3004/proxy/heartbeat

# MCP interface of the shared production proxy (plain HTTP on the internal network; OAuth is decided by the proxy access lists).
# Used by proxy_peer_auth to call the service the way every MCP client does, with no token from the pipeline side.
MCP_PROXY_MCP_ENDPOINT_DEV=http://mcp-proxy:3005/mcp
MCP_PROXY_MCP_ENDPOINT_PROD=http://mcp-proxy:3005/mcp

# onedrive-backup service: registration id and the address as currently reachable (the Docker
# network name of the container; port 8050 is not published to the host).
ONEDRIVE_BACKUP_ID_DEV=onedrive-backup
ONEDRIVE_BACKUP_ID_PROD=onedrive-backup
ONEDRIVE_BACKUP_URL_DEV=https://onedrive-backup:8050
ONEDRIVE_BACKUP_URL_PROD=https://onedrive-backup:8050

# LAN endpoint of the Vue SPA, odbcli and the pipeline (revision 8, PP3): the service port is published on the LAN, host 8443 ->
# container 8050, server-auth HTTPS with a certificate from the project CA (SAN holds the IP and the docker alias). One value for
# both environments: onedrive-backup is production-only. The browser, Playwright and the pipeline trust the project CA only.
ONEDRIVE_BACKUP_LAN_URL_DEV=https://192.168.254.26:8443
ONEDRIVE_BACKUP_LAN_URL_PROD=https://192.168.254.26:8443
