# Non-secret deployment values. Installed to /etc/default/onedrive-backup.
ONEDRIVE_IMAGE=vasilyvz/onedrive-backup:0.3.21
ONEDRIVE_CONTAINER=onedrive-backup
ONEDRIVE_NETWORK=smart-assistant
ONEDRIVE_CONFIG_DIR=/etc/onedrive-backup
ONEDRIVE_DATA_DIR=/srv/archive/onedrive-backup
ONEDRIVE_SECRET_DIR=/var/lib/onedrive-backup/secrets
ONEDRIVE_RCLONE_STATE_DIR=/var/lib/onedrive-backup/rclone-state
ONEDRIVE_CREDENTIALS_FILE=/var/lib/onedrive-backup/credentials/.env
